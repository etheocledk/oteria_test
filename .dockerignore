# Secrets and local state never go into the image.
.env
.env.*
!.env.example
auth.json

# Rebuilt inside the image.
node_modules
vendor
public/js
public/css
public/mix-manifest.json
public/hot
public/storage
bootstrap/cache/*.php

# Local runtime data.
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/pail

# Development tooling.
.git
.idea
.vscode
.claude
.ai
.mcp.json
.phpunit.cache
.phpunit.result.cache
tests
